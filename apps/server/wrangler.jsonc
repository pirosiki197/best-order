{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "server",
  "compatibility_date": "2025-08-03",
  "compatibility_flags": ["nodejs_compat"],
  "main": "./src/index.ts",
  "r2_buckets": [
    {
      "binding": "R2",
      "bucket_name": "best-order",
    },
  ],
  "hyperdrive": [
    {
      "binding": "HYPERDRIVE",
      "id": "2c7d35fdfe31478a8903d4117ce93dfb",
      "localConnectionString": "postgresql://postgres:password@localhost:5432/best-order",
    },
  ],
  "vars": {
    "R2_PUBLIC_URL": "https://media.pirosiki197.net",
  },
  "env": {
    "dev": {
      "r2_buckets": [
        {
          "binding": "R2",
          "bucket_name": "best-order-dev",
          "remote": true,
        },
      ],
      "vars": {
        "R2_PUBLIC_URL": "https://pub-fc14875b21f843748312e56872f53dab.r2.dev",
        "DATABASE_URL": "postgresql://postgres:password@localhost:5432/best-order",
      },
    },
  },
}
