{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "server",
  "compatibility_date": "2026-05-22",
  "compatibility_flags": ["nodejs_compat"],
  "main": "./src/index.ts",
  "r2_buckets": [
    {
      "binding": "R2",
      "bucket_name": "best-order",
    },
  ],
  "hyperdrive": [
    {
      "binding": "HYPERDRIVE",
      "id": "2c7d35fdfe31478a8903d4117ce93dfb",
      "localConnectionString": "postgresql://postgres:password@localhost:5432/best-order",
    },
  ],
}
